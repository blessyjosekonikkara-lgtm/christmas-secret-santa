rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is the authorized administrator
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'blessyjosekonikkara@gmail.com';
    }

    // 1. Official Participants Collection (Production - 45 Real Family Members)
    // STRICT PRIVACY PROTECTION:
    // - Admin can read the entire collection of participants.
    // - Authenticated family members can ONLY read:
    //    a) PENDING participants (to know which names remain available).
    //    b) REGISTERED participants claimed by their OWN verified email.
    // - Ordinary members CAN NEVER read who registered other family names or list other emails!
    match /participants/{participantId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.status == 'PENDING' ||
          (
            resource.data.status == 'REGISTERED' && 
            resource.data.registeredByEmail != null &&
            resource.data.registeredByEmail.lower() == request.auth.token.email.lower()
          )
        )
      );

      // Only Admin can create or delete participants (e.g. seeding initial 45 roster)
      allow create: if isAdmin();
      allow delete: if isAdmin();

      // Updates:
      // - Admin has full update capability.
      // - Ordinary authenticated users can ONLY claim a PENDING official participant:
      //    * Must be currently PENDING (atomic lock prevents double-claiming)
      //    * Status changes strictly to REGISTERED
      //    * registeredByEmail must match authenticated token email
      //    * registeredByUid must match authenticated user id
      //    * officialName and id must match existing document values (no arbitrary name spoofing)
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status == 'REGISTERED' &&
        request.resource.data.registeredByEmail != null &&
        request.resource.data.registeredByEmail.lower() == request.auth.token.email.lower() &&
        request.resource.data.registeredByUid == request.auth.uid &&
        request.resource.data.officialName == resource.data.officialName &&
        request.resource.data.id == resource.data.id
      );
    }

    // 2. Dummy Participants collection (Isolated testing sandbox: ALICE, BOB, CHARLIE, DAVID)
    match /dummy_participants/{participantId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 3. Secret Santa Assignments collection
    // HIGH SECURITY: Ordinary members can ONLY read their own family's assigned friends!
    // Ordinary members can NEVER read anyone else's assignment or the complete matrix!
    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.giverRegisteredByEmail.lower() == request.auth.token.email.lower() ||
          resource.data.giverRegisteredByUid == request.auth.uid
        )
      );
      
      // Only Admin can create/update/delete assignments before they are locked
      allow create: if isAdmin();
      allow update: if isAdmin() && (!resource.data.locked);
      allow delete: if isAdmin() && (!resource.data.locked);
    }

    // 4. Dummy Assignments (Isolated testing sandbox only)
    match /dummy_assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 5. System Settings (lock status, assignment status)
    match /systemSettings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 6. User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
