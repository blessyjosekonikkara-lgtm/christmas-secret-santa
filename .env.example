# ==========================================
# Christmas Secret Santa 2026 Environment Configuration
# ==========================================

# 1. MongoDB Atlas Connection URI
# Enter your full MongoDB Atlas connection string (including username, password, and cluster host)
# Example: mongodb+srv://<username>:<password>@cluster0.6nsafqo.mongodb.net/secret_santa?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.6nsafqo.mongodb.net/secret_santa?retryWrites=true&w=majority

# 2. Database Name (optional, defaults to secret_santa)
MONGODB_DB_NAME=secret_santa

# 3. Authorized Administrator Email
ADMIN_EMAIL=blessyjosekonikkara@gmail.com

# 4. Environment
NODE_ENV=production
